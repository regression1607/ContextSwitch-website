# ContextSwitch Website Environment Variables
# Copy this to .env.local for local development

# Backend API URL
VITE_API_URL=http://localhost:5001/api

# Production API URL (uncomment for production)
# VITE_API_URL=https://api.context-switch.dev/api

# Razorpay Key ID (Get from https://dashboard.razorpay.com/app/keys)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
